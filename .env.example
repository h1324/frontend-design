# Copy to .env and fill in. Never commit .env with real values.

# Matches docker-compose.yml credentials for local development.
DATABASE_URL="postgresql://epe:epe@localhost:5432/epe_erp?schema=public"

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"

# Shared bearer token for the scheduled aging sweep (spec S12). The plant's cron container
# POSTs to /api/jobs/aging-sweep hourly with `Authorization: Bearer <this>`. Unset → the
# endpoint refuses to run. Generate one with: openssl rand -hex 32
AGING_SWEEP_TOKEN="replace-me-with-a-long-random-string"
