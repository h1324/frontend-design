# Copy to .env and fill in. Never commit .env with real values.
#
# Local dev uses DATABASE_URL below against the compose Postgres. Under Docker Compose the app
# builds DATABASE_URL from the POSTGRES_* values and reaches the DB over the internal network, so
# for a containerised deploy set POSTGRES_PASSWORD (and optionally POSTGRES_USER/DB) plus the two
# required secrets; DATABASE_URL here is only used when running the app directly on the host.

# Local (host) database URL — matches docker-compose.yml credentials for development.
DATABASE_URL="postgresql://epe:epe@localhost:5432/epe_erp?schema=public"

# Auth.js session secret. REQUIRED. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Shared bearer token for the scheduled aging sweep (spec S12). REQUIRED. The sweeper container
# POSTs to /api/jobs/aging-sweep hourly with `Authorization: Bearer <this>`. Unset → the endpoint
# refuses to run. Generate one with: openssl rand -hex 32
AGING_SWEEP_TOKEN="replace-me-with-a-long-random-string"

# --- Docker Compose only ---------------------------------------------------------------
# Postgres credentials for the db service (the app derives its DATABASE_URL from these).
POSTGRES_USER="epe"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="epe_erp"

# Aging-sweep cadence in seconds (default 3600 = hourly).
SWEEP_INTERVAL="3600"

# Set to true for the FIRST boot of a fresh database only, then unset so the seed never re-runs.
RUN_SEED="false"
