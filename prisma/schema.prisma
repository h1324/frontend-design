// EPE Foam ERP — schema. Migrations only; never hand-edit a live DB (CLAUDE.md).
// S0: Company + User + Role. S2: Plant, AuditLog, DocSeries, shared enums.
// S3: the stock ledger — Location, a minimal Item (extended by S5), Roll, StockBalance,
// and the append-only StockLedger journal.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; "debian-openssl-3.0.x" for the Docker runtime (Debian bookworm) —
  // pinned explicitly because Prisma can mis-detect the OpenSSL version inside the slim image
  // and otherwise ships the wrong query engine ("...generated for debian-openssl-1.1.x").
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- enums ---------------------------------------------------------------------------

/// Roles gate access across the system (spec S4). The authorization matrix is built in S4.
enum Role {
  ADMIN
  PRODUCTION
  STORES
  SALES
  DISPATCH
  ACCOUNTS
  QC
  VIEWER
}

/// Distinct kinds of tracked item (spec S5). Foam attributes apply only to the roll types.
enum ItemType {
  RAW_MATERIAL
  WIP_ROLL
  FINISHED_GOOD
  CONSUMABLE
  PACKING
}

/// Roll lifecycle. The aging queue (Phase 1), stock ledger (S3) and dispatch (Phase 2)
/// all key off this.
enum RollState {
  CURING
  AVAILABLE
  ALLOCATED
  DISPATCHED
  CONSUMED
  REJECTED
  CANCELLED
}

/// Surface treatment of a foam item (spec S5).
enum SurfaceTreatment {
  PLAIN
  ANTI_STATIC
  LAMINATED
  PERFORATED
}

/// Direction of a stock-ledger posting (spec S3).
enum StockDirection {
  IN
  OUT
}

/// Whether a movement is against a serial roll or a fungible bulk item (spec S3).
enum StockGrain {
  SERIAL
  BULK
}

/// What caused a stock movement. REVERSAL is a compensating entry (see StockLedger).
enum StockReason {
  PRODUCTION
  GRN
  DISPATCH
  CONVERT_IN
  CONVERT_OUT
  ADJUSTMENT
  QC_PASS
  QC_FAIL
  REVERSAL
}

/// Customer tier (spec S7). Placeholder only — the scoring model is deferred to Phase 2.
/// New customers default to UNGRADED.
enum CustomerTier {
  A
  B
  C
  UNGRADED
}

/// Downtime reason categories (spec S8). What OEE availability-loss analysis groups on;
/// the free code/description on a DowntimeReason names the specifics.
enum DowntimeCategory {
  DIE_CHANGE
  RM_CHANGEOVER
  BREAKDOWN
  POWER_CUT
  NO_ORDERS
  MAINTENANCE
  OTHER
}

/// Status of a stores document (spec S9). Documents are cancelled, never deleted;
/// cancellation reverses the stock via S3 reversing entries.
enum MaterialDocStatus {
  POSTED
  CANCELLED
}

/// Per-GRN-line QC state (spec S15/S16). Received stock lands PENDING on a QC-hold location;
/// QC (S16) passes/fails/partially-dispositions it, moving accepted qty to free stock.
enum QcLineStatus {
  PENDING
  PASSED
  FAILED
  PARTIAL
}

/// What a QC inspection is against (spec S16): an incoming GRN line or a produced roll.
enum QcRefType {
  GRN_LINE
  ROLL
}

/// A QC disposition (spec S16). PARTIAL splits the quantity into passed/failed.
enum QcResult {
  PASS
  FAIL
  PARTIAL
}

/// A measured QC metric (spec S16). Density is the defining EPE quality spec (CLAUDE.md).
enum QcMetric {
  DENSITY
  THICKNESS
  DIMENSION
  VISUAL
  OTHER
}

/// Production lot lifecycle (spec S10). A CLOSED lot is immutable except by cancellation.
enum LotStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Purchase-order lifecycle (spec S14). DRAFT is editable; OPEN is released to the supplier
/// and receivable (S15); CLOSED is fully/short received; CANCELLED keeps its number.
enum PurchaseOrderStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

/// How an item participates in predictive reorder (spec S28). AUTO_SUGGEST raises an alert when
/// available on-hand falls at/below the reorder point; MANUAL is excluded from the scan. Neither
/// ever auto-buys — a suggestion is advisory and a human confirms the PO.
enum ReorderPolicy {
  MANUAL
  AUTO_SUGGEST
}

/// Lifecycle of a materialised reorder suggestion (spec S28). OPEN is a live alert; PO_DRAFTED
/// links the DRAFT PO a buyer generated; DISMISSED carries a reason; EXPIRED is superseded by a
/// newer scan for the same item.
enum ReorderSuggestionStatus {
  OPEN
  PO_DRAFTED
  DISMISSED
  EXPIRED
}

/// Post-extrusion converting operation (spec S17). Lamination bonds sheets (children re-cure);
/// slitting/bag-making cut without re-curing (children inherit the parents' aged status).
enum ConvertingOperation {
  LAMINATION
  SLITTING
  BAG_MAKING
}

// --- company / plant -----------------------------------------------------------------

/// The operating entity. Single company at launch, but every table carries companyId
/// from day one to avoid a painful multi-entity retrofit (specs/README cross-cutting #3).
model Company {
  id               String   @id @default(cuid())
  name             String
  legalName        String?
  gstin            String?
  /// Plant-wide default aging/curing period (days). An item may override via agingDays;
  /// resolution is Item.agingDays ?? Company.defaultAgingDays (spec S5, decision B4).
  defaultAgingDays Int      @default(7)
  createdAt        DateTime @default(now())

  users              User[]
  plants             Plant[]
  auditLogs          AuditLog[]
  docSeries          DocSeries[]
  locations          Location[]
  items              Item[]
  suppliers          Supplier[]
  customers          Customer[]
  machines           Machine[]
  shifts             Shift[]
  operators          Operator[]
  downtimeReasons    DowntimeReason[]
  materialReceipts   MaterialReceipt[]
  materialIssues     MaterialIssue[]
  lots               Lot[]
  rolls              Roll[]
  stockLedger        StockLedger[]
  stockBalances      StockBalance[]
  dispatchNotes      DispatchNote[]
  invoices           Invoice[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  qcInspections      QcInspection[]
  convertingOrders   ConvertingOrder[]
  salesOrders        SalesOrder[]
  receipts           Receipt[]
  grnCharges         GrnCharge[]
  itemCostHistory    ItemCostHistory[]
  costRates          CostRate[]
  lotCosts           LotCost[]
  convertingCosts    ConvertingOrderCost[]
  einvoiceLogs       EInvoiceLog[]
  tallySyncs         TallySync[]
  customerTallyMaps  CustomerTallyMap[]
  quotations         Quotation[]
  priceContracts     PriceContract[]
  valueDiscounts     ValueDiscountTier[]
  mobileSubmissions  OrderDraftSubmission[]
  reorderSuggestions ReorderSuggestion[]
}

model Plant {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  code        String
  addressJson Json?
  createdAt   DateTime @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  auditLogs   AuditLog[]
  stockLedger StockLedger[]

  @@index([companyId])
}

// --- audit log (append-only) ---------------------------------------------------------

/// Every stock and financial movement writes one of these (CLAUDE.md rule 8). Append-only:
/// rows are inserted, never updated or deleted — enforced by a DB trigger (see migration)
/// as well as by convention (no update/delete helpers exist). Corrections are new rows.
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  entity      String
  entityId    String
  action      String
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  beforeJson  Json?
  afterJson   Json?
  at          DateTime @default(now())

  @@index([companyId])
  @@index([entity, entityId])
  @@index([at])
}

// --- document numbering --------------------------------------------------------------

/// One gapless counter per (company, docType, financial year). Numbers are financial-
/// year-wise, gapless, and cancel-not-delete (CLAUDE.md rule 7). Allocation increments
/// nextSeq under a row lock inside the caller's transaction, so a rolled-back document
/// rolls back its number too — which a bare Postgres sequence cannot guarantee.
model DocSeries {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  docType       String
  financialYear String // e.g. "2026-27"
  prefix        String
  nextSeq       Int     @default(1)

  @@unique([companyId, docType, financialYear])
}

// --- stock: masters referenced by the ledger -----------------------------------------

/// A storage location (warehouse / aging bay / dispatch dock). Flat for now; bins later.
model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String
  /// QC-hold locations quarantine received-but-unpassed stock (spec S15). Stock here is not
  /// free/issuable; QC (S16) transfers accepted qty out to a free location.
  isQcHold  Boolean  @default(false)
  /// Reject locations hold QC-failed stock (spec S16), segregated from free/issuable stock.
  isReject  Boolean  @default(false)
  createdAt DateTime @default(now())

  rolls                Roll[]
  stockBalances        StockBalance[]
  stockLedger          StockLedger[]
  materialReceiptLines MaterialReceiptLine[]
  materialIssueLines   MaterialIssueLine[]
  goodsReceiptLines    GoodsReceiptLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// The item master (spec S5). Foam attributes are nullable and required only for the roll
/// types (FINISHED_GOOD / WIP_ROLL); non-foam items (raw material, consumable, packing)
/// leave them null. HSN is free text, never hardcoded.
model Item {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  code       String
  name       String
  type       ItemType
  uomBase    String // KG | M2 | NOS | LITRE
  hsnCode    String? // free text; validated for 2/4/6/8-digit format only
  gstRatePct Decimal? @db.Decimal(5, 2) // per-SKU GST rate for invoicing (spec S13); EPE sheets are Chapter 39

  // foam attributes (nullable; required for FINISHED_GOOD / WIP_ROLL)
  grade            String?
  thickness_mm     Decimal?          @db.Decimal(9, 3)
  width_mm         Decimal?          @db.Decimal(9, 2)
  density_kg_m3    Decimal?          @db.Decimal(9, 3)
  /// QC tolerance band (± kg/m³) around the target density for roll QC (spec S16).
  densityTolerance Decimal?          @db.Decimal(9, 3)
  colour           String?
  layerCount       Int?
  surfaceTreatment SurfaceTreatment?

  /// Default/list selling price per billed unit (paise) — the lowest-precedence rate the S25
  /// price resolver falls back to when no customer/tier price contract applies. Null = no list
  /// price, so a manual rate is required. Not a cost; the sell side of the item master.
  listPricePaise BigInt?

  // aging: per-item override of Company.defaultAgingDays (decision B4)
  agingDays    Int?
  reorderLevel Decimal? @db.Decimal(16, 3) // legacy manual level (S5); superseded by the computed reorderPoint (S28)

  // predictive reorder (spec S28). reorderPoint is the computed alert threshold
  // (avgDailyConsumption × leadTimeDays + safetyStock); the three inputs are stored so a buyer
  // can see why. Nullable — an item with no reorder policy is skipped by the scan.
  reorderPoint  Decimal?      @db.Decimal(16, 3)
  safetyStock   Decimal?      @db.Decimal(16, 3)
  leadTimeDays  Int?
  reorderPolicy ReorderPolicy @default(AUTO_SUGGEST)

  // landed-cost valuation (spec S20): moving weighted-average landed cost and the quantity it
  // was averaged over. Maintained by lib/landed-cost.ts on each costed receipt; never floats.
  movingAvgCostPaise BigInt  @default(0)
  costedQtyBase      Decimal @default(0) @db.Decimal(16, 3)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rolls                Roll[]
  stockBalances        StockBalance[]
  stockLedger          StockLedger[]
  materialReceiptLines MaterialReceiptLine[]
  materialIssueLines   MaterialIssueLine[]
  producedInLots       Lot[]
  invoiceLines         InvoiceLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  qcInspections        QcInspection[]
  convertedInOrders    ConvertingOrder[]
  salesOrderLines      SalesOrderLine[]
  costHistory          ItemCostHistory[]
  quotationLines       QuotationLine[]
  priceContractLines   PriceContractLine[]
  reorderSuggestions   ReorderSuggestion[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
}

/// Supplier master (spec S6). Parties the plant buys from — polymer, blowing agent,
/// additives, packing. GSTIN is nullable (some small suppliers are unregistered).
model Supplier {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  code         String
  name         String
  legalName    String?
  gstin        String? // validated for 15-char format when present; null = unregistered
  addressJson  Json? // { line1, city, state, pincode }
  contactJson  Json? // { person, phone, email }
  suppliesJson Json? // string[] tags: LDPE | BUTANE | TALC | GMS | MASTERBATCH | PACKING
  paymentTerms String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  materialReceipts   MaterialReceipt[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  reorderSuggestions ReorderSuggestion[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Customer master (spec S7). Billing identity + credit terms live here; ship-to
/// addresses hang off ShipToAddress (each with its own GST state code, for the future
/// CGST/SGST-vs-IGST determination). Credit limit is stored, not enforced (Phase 2).
model Customer {
  id                    String       @id @default(cuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id])
  code                  String
  name                  String
  legalName             String?
  gstin                 String? // validated for format when present; null = unregistered
  pan                   String?
  creditLimit           Decimal      @default(0) @db.Decimal(14, 2)
  creditDays            Int          @default(0)
  paymentTerms          String?
  transporterPreference String?
  tier                  CustomerTier @default(UNGRADED)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())

  shipTos           ShipToAddress[]
  dispatchNotes     DispatchNote[]
  invoices          Invoice[]
  salesOrders       SalesOrder[]
  receipts          Receipt[]
  tallyMap          CustomerTallyMap?
  quotations        Quotation[]
  priceContracts    PriceContract[]
  valueDiscounts    ValueDiscountTier[]
  mobileSubmissions OrderDraftSubmission[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// A delivery destination for a customer. Exactly one per customer is the default. The
/// gstStateCode drives ship-to-state tax logic in Phase 2 (brief §7).
model ShipToAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String
  addressJson  Json? // { line1, city, state, pincode }
  gstStateCode String // 2-digit GST state code
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  dispatchNotes DispatchNote[]
  invoices      Invoice[]
  salesOrders   SalesOrder[]
  quotations    Quotation[]

  @@index([customerId])
}

// --- production batch / lot (spec S10) -----------------------------------------------

/// One continuous extrusion run: one machine, one shift, one SKU. The root of genealogy
/// and the source of every production KPI. A CLOSED lot is immutable except by cancellation.
model Lot {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  lotNo        String // LOT/FY/seq
  machineId    String
  machine      Machine  @relation(fields: [machineId], references: [id])
  shiftId      String
  shift        Shift    @relation(fields: [shiftId], references: [id])
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  targetItemId String
  targetItem   Item     @relation(fields: [targetItemId], references: [id])

  productionDate DateTime
  startAt        DateTime?
  endAt          DateTime?

  regrindPct Decimal  @default(0) @db.Decimal(6, 3) // derived from issue lines flagged regrind
  outputKg   Decimal  @default(0) @db.Decimal(14, 3)
  scrapKg    Decimal  @default(0) @db.Decimal(14, 3)
  trimKg     Decimal  @default(0) @db.Decimal(14, 3)
  energyKwh  Decimal? @db.Decimal(12, 3) // for kWh/kg; nullable until a meter feeds it

  status      LotStatus @default(OPEN)
  createdById String?
  createdAt   DateTime  @default(now())

  rolls          Roll[]
  materialIssues MaterialIssue[]
  downtimeLogs   DowntimeLog[]
  cost           LotCost?

  @@unique([companyId, lotNo])
  @@index([companyId])
  @@index([companyId, status])
}

/// Reason-coded downtime for a lot. Minutes feed OEE availability loss (Phase 3).
model DowntimeLog {
  id        String         @id @default(cuid())
  lotId     String
  lot       Lot            @relation(fields: [lotId], references: [id], onDelete: Cascade)
  reasonId  String
  reason    DowntimeReason @relation(fields: [reasonId], references: [id])
  minutes   Int
  note      String?
  createdAt DateTime       @default(now())

  @@index([lotId])
}

// --- raw-material stores (spec S9) ---------------------------------------------------

/// A raw-material receipt (stock IN). Each line posts a BULK IN to the ledger. Lightweight
/// for commissioning — full PO/GRN/QC/landed-cost is Phase 2. Cancel-not-delete.
model MaterialReceipt {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  docNo       String // RCPT/FY/seq
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  receivedAt  DateTime          @default(now())
  refNote     String?
  createdById String? // acting user (audit log holds the authoritative actor)
  status      MaterialDocStatus @default(POSTED)
  createdAt   DateTime          @default(now())

  lines MaterialReceiptLine[]

  @@unique([companyId, docNo])
  @@index([companyId])
}

model MaterialReceiptLine {
  id         String          @id @default(cuid())
  receiptId  String
  receipt    MaterialReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item            @relation(fields: [itemId], references: [id])
  locationId String
  location   Location        @relation(fields: [locationId], references: [id])
  qtyBase    Decimal         @db.Decimal(16, 3)
  ratePaise  Int? // optional landed rate; valuation is Phase 3
  ledgerId   String? // the BULK IN posting, for reversal on cancel
}

/// A raw-material issue to a production batch (stock OUT, negative-blocked). `isRegrind`
/// marks blend composition for the batch's regrind-% calc (S10). Cancel-not-delete.
model MaterialIssue {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  docNo       String // ISS/FY/seq
  lotId       String? // the batch consuming the material
  lot         Lot?              @relation(fields: [lotId], references: [id])
  issuedAt    DateTime          @default(now())
  refNote     String?
  createdById String?
  status      MaterialDocStatus @default(POSTED)
  createdAt   DateTime          @default(now())

  lines MaterialIssueLine[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([lotId])
}

model MaterialIssueLine {
  id         String        @id @default(cuid())
  issueId    String
  issue      MaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  locationId String
  location   Location      @relation(fields: [locationId], references: [id])
  qtyBase    Decimal       @db.Decimal(16, 3)
  isRegrind  Boolean       @default(false)
  ledgerId   String? // the BULK OUT posting, for reversal on cancel
}

// --- production masters (spec S8) ----------------------------------------------------

/// An extrusion/converting machine (e.g. the FLY-250 line). Rated capacity feeds the
/// kg/hour-vs-capacity KPI.
model Machine {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  code              String
  name              String
  ratedCapacityKgHr Decimal? @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  lots             Lot[]
  convertingOrders ConvertingOrder[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// A work shift. Times are stored as "HH:MM"; end < start means the shift crosses midnight.
model Shift {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  lots             Lot[]
  convertingOrders ConvertingOrder[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// A machine operator (a name on a batch, not necessarily a system user).
model Operator {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  lots             Lot[]
  convertingOrders ConvertingOrder[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// A reason-coded downtime cause. `category` feeds OEE; `code`/`description` name specifics.
model DowntimeReason {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  code        String
  description String
  category    DowntimeCategory
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  downtimeLogs DowntimeLog[]

  @@unique([companyId, code])
  @@index([companyId])
}

// --- stock: serial rolls -------------------------------------------------------------

/// A single physical roll — the atomic serial-tracked unit. Carries both weights
/// (theoretical from dimensions×density, and actual weighed) and m² (from dimensions),
/// never one without the other (CLAUDE.md rules 3 & 4).
model Roll {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  lotId      String?
  lot        Lot?     @relation(fields: [lotId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Human-readable identity + label state (spec S11). rollNo is gapless per FY, immutable
  // once assigned, and is THE identifier — there is no barcode/scanning system.
  rollNo          String
  labelPrintedAt  DateTime?
  labelPrintCount Int       @default(0)

  // QC gate (spec S16). A roll needs qcStatus = PASSED *and* aging complete (S12) to become
  // AVAILABLE; the two gates are independent. Fresh production rolls start PENDING.
  qcStatus      QcLineStatus @default(PENDING)
  qcInspectedAt DateTime?

  // Converting genealogy (spec S17). A child roll points at the ConvertingOrder that produced
  // it; a parent roll is referenced by that order's ConvertingInput rows (→ convertingInputs).
  convertingOrderId String?
  convertingOrder   ConvertingOrder? @relation("ConvertingChildren", fields: [convertingOrderId], references: [id])

  state      RollState @default(CURING)
  length_m   Decimal   @db.Decimal(12, 3)
  width_m    Decimal   @db.Decimal(12, 3)
  layersJson Json // ordered layer stack [{ thickness_mm, density_kg_m3 }, ...]

  qtyKgTheoretical Decimal   @db.Decimal(14, 3)
  qtyKgActual      Decimal   @db.Decimal(14, 3)
  qtyM2            Decimal   @db.Decimal(14, 4)
  densityKgM3      Decimal   @db.Decimal(9, 3)
  agingReadyDate   DateTime?

  // Costing snapshot (spec S21): this roll's share of its lot/converting-order cost, allocated
  // by weight. Null until the lot/order is costed. Money in paise (BigInt).
  unitCostPaise BigInt?

  createdAt DateTime @default(now())

  ledgerEntries    StockLedger[]
  dispatchRolls    DispatchRoll[]
  convertingInputs ConvertingInput[]
  salesOrderRolls  SalesOrderRoll[]

  @@unique([companyId, rollNo])
  @@index([companyId])
  @@index([companyId, itemId, state])
}

// --- stock: bulk balance -------------------------------------------------------------

/// Running balance for fungible bulk items per location. This is a cache over the ledger,
/// updated in the same transaction as each posting. OUT postings are guarded so the
/// balance can never go negative (resolved decision: block for bulk RM).
model StockBalance {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  qtyBase    Decimal  @default(0) @db.Decimal(16, 3)
  updatedAt  DateTime @updatedAt

  @@unique([companyId, itemId, locationId])
  @@index([companyId])
}

// --- stock: the append-only journal --------------------------------------------------

/// The append-only record of every stock movement (CLAUDE.md rule 6). A DB trigger (see
/// migration) rejects UPDATE/DELETE. Corrections are REVERSAL rows: the reversing row
/// points at the original via reversesLedgerId — the pointer lives on the reversing row
/// precisely because the original can never be updated.
model StockLedger {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  at        DateTime @default(now())

  grain     StockGrain
  direction StockDirection
  reason    StockReason

  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  rollId     String?
  roll       Roll?    @relation(fields: [rollId], references: [id])

  qtyBase Decimal  @db.Decimal(16, 3) // magnitude in the item's base unit
  qtyKg   Decimal? @db.Decimal(14, 3) // foam weight (actual), null for non-foam bulk
  qtyM2   Decimal? @db.Decimal(14, 4) // foam area, null for non-foam bulk

  refType String?
  refId   String?

  reversesLedgerId String?      @unique
  reverses         StockLedger? @relation("LedgerReversal", fields: [reversesLedgerId], references: [id])
  reversedBy       StockLedger? @relation("LedgerReversal")

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id])

  @@index([companyId])
  @@index([companyId, itemId, locationId])
  @@index([rollId])
}

// --- Dispatch & Invoice (spec S13) ---------------------------------------------------

enum DispatchStatus {
  OPEN
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// Sales-order lifecycle (spec S18). DRAFT → CONFIRMED (credit-checked) → PARTIALLY_FULFILLED
/// as dispatches ship against it → FULFILLED. Cancellable from any non-terminal state.
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

/// Credit standing of a sales order at confirmation (spec S18). OK within the limit; BLOCKED
/// over it; OVERRIDDEN when an ACCOUNTS/ADMIN user cleared the block with a logged reason.
enum CreditStatus {
  OK
  BLOCKED
  OVERRIDDEN
}

/// A shipment of specific rolls to a customer/ship-to. Picking allocates rolls; issuing the
/// invoice posts the SERIAL-OUT and flips them DISPATCHED.
model DispatchNote {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  docNo        String // DN/FY/seq
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id])
  shipToId     String
  shipTo       ShipToAddress  @relation(fields: [shipToId], references: [id])
  // Optional link to the sales order this shipment fulfils (spec S18); null for ad-hoc dispatch.
  salesOrderId String?
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  dispatchedAt DateTime?
  transporter  String?
  vehicleNo    String?
  lrNo         String?
  status       DispatchStatus @default(OPEN)
  createdById  String?
  createdAt    DateTime       @default(now())

  rolls   DispatchRoll[]
  invoice Invoice?

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
}

/// The specific rolls on a dispatch note — one row per physical roll (genealogy anchor).
model DispatchRoll {
  id             String       @id @default(cuid())
  dispatchNoteId String
  dispatchNote   DispatchNote @relation(fields: [dispatchNoteId], references: [id], onDelete: Cascade)
  rollId         String
  roll           Roll         @relation(fields: [rollId], references: [id])

  @@unique([dispatchNoteId, rollId])
  @@index([dispatchNoteId])
  @@index([rollId])
}

/// A GST tax invoice for a dispatch. Money in paise (integers). IRN/signed-QR/e-way-bill
/// fields exist from day one (brief §7) though the APIs are Phase 3. Not a ledger — this is
/// the document; statutory books stay in Tally.
model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  docNo          String // INV/FY/seq
  dispatchNoteId String        @unique
  dispatchNote   DispatchNote  @relation(fields: [dispatchNoteId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  shipToId       String
  shipTo         ShipToAddress @relation(fields: [shipToId], references: [id])
  invoiceDate    DateTime      @default(now())

  placeOfSupplyStateCode String
  taxableValuePaise      BigInt
  cgstPaise              BigInt @default(0)
  sgstPaise              BigInt @default(0)
  igstPaise              BigInt @default(0)
  roundOffPaise          BigInt @default(0)
  totalPaise             BigInt

  // Receivables ageing (spec S19). dueDate = invoiceDate + customer.creditDays (IST);
  // amountSettledPaise is a maintained running total of receipt allocations to this invoice.
  dueDate            DateTime?
  amountSettledPaise BigInt    @default(0)

  // e-invoice / e-way-bill fields — populated by the S23 IRP/GSP calls; null until then.
  irn            String?
  signedQr       String?
  ackNo          String?
  ackDate        DateTime?
  ewbNo          String?
  ewbValidTill   DateTime?
  einvoiceStatus EInvoiceStatus @default(NONE)

  status      InvoiceStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime      @default(now())

  lines              InvoiceLine[]
  receiptAllocations ReceiptAllocation[]
  einvoiceLogs       EInvoiceLog[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
}

// --- e-invoice (IRN) & e-way bill (spec S23) -----------------------------------------

/// E-invoice lifecycle on an invoice (spec S23). NONE = below threshold or not yet generated.
enum EInvoiceStatus {
  NONE
  GENERATED
  CANCELLED
}

/// An IRP/e-way-bill API action (spec S23).
enum EInvoiceAction {
  GEN_IRN
  CANCEL_IRN
  GEN_EWB
  CANCEL_EWB
}

/// Outcome of an IRP/e-way-bill call (spec S23).
enum EInvoiceLogStatus {
  OK
  ERROR
}

/// An attempt log for every IRP/NIC call (spec S23) — nothing is silently dropped. `provider`
/// is free text (MOCK now; a real GSP later). Secrets never land here.
model EInvoiceLog {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id])
  invoiceId    String
  invoice      Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action       EInvoiceAction
  provider     String
  status       EInvoiceLogStatus
  requestHash  String
  responseRef  String?
  errorCode    String?
  errorMessage String?
  at           DateTime          @default(now())

  @@index([companyId])
  @@index([invoiceId])
}

/// One line per SKU on an invoice. Carries both kg and m² (CLAUDE.md 3) and its own HSN + rate.
model InvoiceLine {
  id                String  @id @default(cuid())
  invoiceId         String
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item    @relation(fields: [itemId], references: [id])
  description       String
  hsnCode           String?
  qtyKg             Decimal @db.Decimal(14, 3)
  qtyM2             Decimal @db.Decimal(14, 4)
  ratePaise         BigInt // rate per billed unit (item's base UOM)
  gstRatePct        Decimal @db.Decimal(5, 2)
  taxableValuePaise BigInt
  cgstPaise         BigInt  @default(0)
  sgstPaise         BigInt  @default(0)
  igstPaise         BigInt  @default(0)

  @@index([invoiceId])
}

// --- receivables ageing (spec S19) ---------------------------------------------------

/// How a receipt was tendered (spec S19). ADJUSTMENT covers credit/debit notes and write-offs.
enum ReceiptMode {
  CASH
  BANK
  UPI
  CHEQUE
  ADJUSTMENT
}

/// Where a receipt originated. MANUAL now; a one-way Tally→ERP sync (Phase 3) will mark TALLY
/// so the two are never double-counted (spec S19 open question).
enum ReceiptSource {
  MANUAL
  TALLY
}

enum ReceiptStatus {
  POSTED
  CANCELLED
}

/// A customer payment recorded for credit control only (spec S19) — NOT a ledger posting; the
/// statutory books stay in Tally (CLAUDE.md). Outstanding = issued invoices − posted receipts.
/// Reversible by cancellation, never edited. Gapless FY numbers.
model Receipt {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  docNo       String // RCT/FY/seq
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  receivedAt  DateTime      @default(now())
  mode        ReceiptMode   @default(BANK)
  amountPaise BigInt
  reference   String? // cheque/UTR/UPI ref
  source      ReceiptSource @default(MANUAL)
  status      ReceiptStatus @default(POSTED)
  createdById String?
  createdAt   DateTime      @default(now())

  allocations ReceiptAllocation[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, customerId])
}

/// Which invoices a receipt settles (spec S19). The sum of a receipt's allocations cannot
/// exceed its amount; an invoice cannot be settled beyond its total. Unallocated amount is
/// "on account".
model ReceiptAllocation {
  id          String  @id @default(cuid())
  receiptId   String
  receipt     Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  amountPaise BigInt

  @@unique([receiptId, invoiceId])
  @@index([receiptId])
  @@index([invoiceId])
}

// --- Tally sync (spec S24) -----------------------------------------------------------

/// What a sync row concerns (spec S24). Invoices flow OUT (ERP→Tally); receipts flow IN.
enum TallyEntityType {
  INVOICE
  RECEIPT
}

enum TallySyncDirection {
  OUT
  IN
}

/// Lifecycle of a Tally sync attempt (spec S24). PENDING queued, SENT dispatched, ACK confirmed
/// by Tally, ERROR failed (retryable), SKIPPED already synced / not applicable.
enum TallySyncStatus {
  PENDING
  SENT
  ACK
  ERROR
  SKIPPED
}

/// One marshalling attempt across the Tally boundary (spec S24) — NOT a ledger. Idempotency is
/// by `payloadHash` (outbound invoices) and `externalRef` (inbound receipts); every attempt is
/// logged and retryable. Balances live in Tally.
model TallySync {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id])
  entityType  TallyEntityType
  entityId    String? // Invoice.id / Receipt.id; null for a not-yet-imported inbound voucher
  direction   TallySyncDirection
  status      TallySyncStatus    @default(PENDING)
  externalRef String? // Tally voucher GUID / number
  payloadHash String?
  attempts    Int                @default(0)
  lastError   String?
  at          DateTime           @default(now())

  @@index([companyId])
  @@index([companyId, entityType, status])
  @@index([companyId, externalRef])
}

/// Maps a customer to its Tally ledger name (spec S24). Falls back to the customer name when
/// absent. Master data is assumed to already exist in Tally — this only names the party.
model CustomerTallyMap {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  customerId      String   @unique
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tallyLedgerName String
  createdAt       DateTime @default(now())

  @@index([companyId])
}

// --- sales order & credit control (spec S18) -----------------------------------------

/// A customer order layered over direct dispatch (spec S18). Captures the order, reserves
/// stock against it, and enforces the credit limit (S7) at confirmation with a logged
/// override. Dispatch (S13) fulfils an SO instead of being raised ad-hoc. Numbers are
/// gapless per FY; cancel-not-delete.
model SalesOrder {
  id                   String           @id @default(cuid())
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id])
  docNo                String // SO/FY/seq
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  shipToId             String
  shipTo               ShipToAddress    @relation(fields: [shipToId], references: [id])
  orderDate            DateTime         @default(now())
  status               SalesOrderStatus @default(DRAFT)
  creditStatus         CreditStatus     @default(OK)
  creditOverrideById   String? // user who cleared a credit block (ACCOUNTS/ADMIN)
  creditOverrideReason String?
  /// Whole-order value discount % (spec S25), applied to the taxable subtotal before GST.
  /// 0 for orders with no qualifying value tier; seeded on convert-from-quote or direct entry.
  orderDiscountPct     Decimal          @default(0) @db.Decimal(5, 2)
  /// How the order was entered (spec S27). DESK is the default desk/web entry; MOBILE marks an
  /// order captured on the field-sales PWA and synced in, so it is distinguishable downstream.
  source               SalesOrderSource @default(DESK)
  createdById          String?
  createdAt            DateTime         @default(now())

  lines            SalesOrderLine[]
  allocations      SalesOrderRoll[]
  dispatchNotes    DispatchNote[]
  fromQuotation    Quotation?            @relation("QuotationConversion")
  mobileSubmission OrderDraftSubmission? @relation("MobileSubmissionSO")

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
  @@index([customerId])
}

/// One ordered line. `qtyFulfilled` is a denormalised running total maintained by dispatch
/// (S13) as shipments ship against the order; `ratePaise` is the agreed price per billed unit.
model SalesOrderLine {
  id           String     @id @default(cuid())
  soId         String
  so           SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id])
  qtyOrdered   Decimal    @db.Decimal(14, 4)
  uom          String
  ratePaise    BigInt
  gstRatePct   Decimal    @db.Decimal(5, 2)
  qtyFulfilled Decimal    @default(0) @db.Decimal(14, 4)

  @@index([soId])
  @@index([itemId])
}

/// A specific roll reserved against a sales order (spec S18 rule 2). Allocation flips the
/// roll AVAILABLE→ALLOCATED (S3); dispatch consumes the reservation. Cancelling the SO
/// releases the roll back to AVAILABLE.
model SalesOrderRoll {
  id     String     @id @default(cuid())
  soId   String
  so     SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  rollId String
  roll   Roll       @relation(fields: [rollId], references: [id])

  @@unique([soId, rollId])
  @@index([soId])
  @@index([rollId])
}

// --- Purchase orders (spec S14) ------------------------------------------------------

/// A purchase order to a supplier. Commitment value is derived from the lines; goods are
/// received against it in S15, which maintains each line's qtyReceived.
model PurchaseOrder {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  docNo         String // PO/FY/seq
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  paymentTerms  String?
  deliveryTerms String?
  // Multi-currency imports are Phase 2+; columns exist now (default INR) to avoid a migration.
  currency      String              @default("INR")
  fxRate        Decimal?            @db.Decimal(12, 6)
  notes         String?
  closeReason   String? // set on a manual short-close
  createdById   String?
  createdAt     DateTime            @default(now())

  lines              PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  reorderSuggestions ReorderSuggestion[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
  @@index([supplierId])
}

/// One ordered line. `qtyReceived` is a denormalised running total maintained by S15 GRNs
/// (source of truth is the GRN rows); `ratePaise` is indicative until the GRN/invoice.
model PurchaseOrderLine {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id])
  description  String?
  qtyOrdered   Decimal       @db.Decimal(14, 3)
  uom          String
  ratePaise    BigInt
  gstRatePct   Decimal?      @db.Decimal(5, 2)
  expectedDate DateTime?
  qtyReceived  Decimal       @default(0) @db.Decimal(14, 3)

  grnLines GoodsReceiptLine[]

  @@index([poId])
  @@index([itemId])
}

// --- Goods receipt / GRN (spec S15) --------------------------------------------------

/// Receipt of supplier goods against a PO (or a direct receipt). Each line posts a BULK IN
/// into a QC-hold location — physically present but not free/issuable until QC passes it (S16).
/// Cancel-not-delete: cancelling reverses the postings (refused if the stock has moved on).
model GoodsReceipt {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  docNo       String // GRN/FY/seq
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  poId        String?
  po          PurchaseOrder?    @relation(fields: [poId], references: [id])
  receivedAt  DateTime          @default(now())
  docketNo    String?
  vehicleNo   String?
  status      MaterialDocStatus @default(POSTED)
  createdById String?
  createdAt   DateTime          @default(now())

  lines   GoodsReceiptLine[]
  charges GrnCharge[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
  @@index([poId])
}

/// One received line. Posts a BULK IN (reason GRN) to a QC-hold location; `qcStatus` starts
/// PENDING and S16 sets `qtyAccepted` + disposition. `ledgerId` is the posting for reversal.
model GoodsReceiptLine {
  id                  String             @id @default(cuid())
  grnId               String
  grn                 GoodsReceipt       @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId            String?
  poLine              PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  itemId              String
  item                Item               @relation(fields: [itemId], references: [id])
  locationId          String
  location            Location           @relation(fields: [locationId], references: [id])
  qtyReceived         Decimal            @db.Decimal(14, 3)
  qtyAccepted         Decimal            @default(0) @db.Decimal(14, 3)
  ratePaise           BigInt?
  // Per-unit landed cost (supplier rate + apportioned charges), set by S20 when the receipt is
  // costed. Null until then. Money in paise (BigInt).
  landedUnitCostPaise BigInt?
  qcStatus            QcLineStatus       @default(PENDING)
  ledgerId            String?

  @@index([grnId])
  @@index([poLineId])
  @@index([itemId])
}

// --- landed-cost valuation (spec S20) ------------------------------------------------

/// Inbound charge categories loaded onto landed cost. Recoverable GST is never a charge here
/// (it is input tax credit, not a cost).
enum ChargeType {
  FREIGHT
  DUTY
  INSURANCE
  CLEARING
  OTHER
}

/// How a charge is spread across a GRN's lines (spec S20).
enum ApportionBasis {
  VALUE
  QTY
  WEIGHT
}

/// A charge on a goods receipt (freight/duty/…) apportioned across its lines to build landed
/// cost (spec S20). Money in paise (BigInt).
model GrnCharge {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  grnId          String
  grn            GoodsReceipt   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  chargeType     ChargeType
  amountPaise    BigInt
  apportionBasis ApportionBasis @default(VALUE)
  note           String?
  createdAt      DateTime       @default(now())

  @@index([companyId])
  @@index([grnId])
}

/// Append-only audit of an item's moving-average landed cost — one row per costed receipt or
/// its reversal (spec S20). `qtyIn` is negative on a reversal. Never updated or deleted.
model ItemCostHistory {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  itemId            String
  item              Item     @relation(fields: [itemId], references: [id])
  grnLineId         String?
  asOf              DateTime @default(now())
  qtyIn             Decimal  @db.Decimal(16, 3)
  unitCostPaise     BigInt
  newMovingAvgPaise BigInt

  @@index([companyId, itemId])
  @@index([grnLineId])
}

// --- batch / production costing (spec S21) -------------------------------------------

/// A costing rate category (spec S21). Energy, labour and a single overhead pool.
enum CostRateKind {
  LABOUR
  OVERHEAD
  ENERGY
}

/// What a costing rate is charged against (spec S21).
enum CostRateBasis {
  PER_KG
  PER_HOUR
  PER_KWH
  PER_ROLL
}

/// An effective-dated conversion-cost rate (spec S21), so historical lots cost at the rate in
/// force on their production date. Money in paise (BigInt).
model CostRate {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  kind          CostRateKind
  ratePaise     BigInt
  basis         CostRateBasis @default(PER_KG)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())

  @@index([companyId, kind])
}

/// The costed roll-up of an extrusion lot (spec S21): RM at landed cost (+ regrind memo) plus
/// energy/labour/overhead → cost per kg and per m². Recomputed on demand and on lot close;
/// a read model over actuals, never touching the stock ledger. Money in paise (BigInt).
model LotCost {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  lotId              String   @unique
  lot                Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  rmCostPaise        BigInt   @default(0)
  regrindCreditPaise BigInt   @default(0)
  energyCostPaise    BigInt   @default(0)
  labourCostPaise    BigInt   @default(0)
  overheadCostPaise  BigInt   @default(0)
  totalCostPaise     BigInt   @default(0)
  outputKg           Decimal  @default(0) @db.Decimal(14, 3)
  outputM2           Decimal  @default(0) @db.Decimal(14, 4)
  costPerKgPaise     BigInt   @default(0)
  costPerM2Paise     BigInt   @default(0)
  computedAt         DateTime @default(now())

  @@index([companyId])
}

/// The costed roll-up of a converting order (spec S21): consumed parent-roll cost + the order's
/// conversion cost, allocated to the child rolls by weight. Money in paise (BigInt).
model ConvertingOrderCost {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id])
  orderId             String          @unique
  order               ConvertingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inputCostPaise      BigInt          @default(0)
  conversionCostPaise BigInt          @default(0)
  totalCostPaise      BigInt          @default(0)
  outputKg            Decimal         @default(0) @db.Decimal(14, 3)
  costPerKgPaise      BigInt          @default(0)
  computedAt          DateTime        @default(now())

  @@index([companyId])
}

// --- Quality control (spec S16) ------------------------------------------------------

/// A QC inspection of an incoming GRN line or a produced roll. Passing releases stock (RM:
/// hold→free; roll: clears the QC gate); failing routes it to reject / REJECTED. Readings are
/// recorded, never averaged away. Gapless FY numbers; append-only (re-inspection is a new row).
model QcInspection {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  docNo       String // QC/FY/seq
  refType     QcRefType
  refId       String // GoodsReceiptLine.id or Roll.id (polymorphic)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  result      QcResult
  qtyPassed   Decimal   @default(0) @db.Decimal(14, 3)
  qtyFailed   Decimal   @default(0) @db.Decimal(14, 3)
  remarks     String?
  inspectedAt DateTime  @default(now())
  createdById String?
  createdAt   DateTime  @default(now())

  readings QcReading[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([refType, refId])
}

/// One sampled reading on an inspection, stored with its in-spec flag (spec S16 rule 3).
model QcReading {
  id           String       @id @default(cuid())
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  metric       QcMetric
  value        Decimal?     @db.Decimal(14, 4)
  uom          String?
  withinSpec   Boolean      @default(true)

  @@index([inspectionId])
}

// --- Converting orders (spec S17) ----------------------------------------------------

/// A post-extrusion converting run: consumes parent rolls and produces child rolls, with the
/// parent→child genealogy complaint tracing needs. Reuses LotStatus (OPEN|CLOSED|CANCELLED).
/// Material balance (parents vs children + scrap + trim) is surfaced, not reconciled.
model ConvertingOrder {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  docNo        String // CV/FY/seq
  operation    ConvertingOperation
  machineId    String
  machine      Machine             @relation(fields: [machineId], references: [id])
  shiftId      String
  shift        Shift               @relation(fields: [shiftId], references: [id])
  operatorId   String
  operator     Operator            @relation(fields: [operatorId], references: [id])
  targetItemId String
  targetItem   Item                @relation(fields: [targetItemId], references: [id])
  status       LotStatus           @default(OPEN)
  inputKg      Decimal             @default(0) @db.Decimal(14, 3)
  outputKg     Decimal             @default(0) @db.Decimal(14, 3)
  scrapKg      Decimal             @default(0) @db.Decimal(14, 3)
  trimKg       Decimal             @default(0) @db.Decimal(14, 3)
  startedAt    DateTime?
  endedAt      DateTime?
  createdById  String?
  createdAt    DateTime            @default(now())

  inputs   ConvertingInput[]
  children Roll[]               @relation("ConvertingChildren")
  cost     ConvertingOrderCost?

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
}

/// A parent roll consumed by a converting order (the genealogy anchor on the input side).
model ConvertingInput {
  id      String          @id @default(cuid())
  orderId String
  order   ConvertingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rollId  String
  roll    Roll            @relation(fields: [rollId], references: [id])

  @@unique([orderId, rollId])
  @@index([orderId])
  @@index([rollId])
}

// --- Quotations & price contracts (spec S25) -----------------------------------------

/// Lifecycle of a quotation. WON converts to a sales order (once); LOST/EXPIRED close it;
/// CANCELLED voids it keeping the number (S2). A quote never moves stock or money.
enum QuotationStatus {
  DRAFT
  SENT
  WON
  LOST
  EXPIRED
  CANCELLED
}

/// Lifecycle of a price contract / value-discount tier. ACTIVE within its validity window;
/// EXPIRED past it; CANCELLED voided. A rate change is a new row, never an in-place edit.
enum PriceContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Who a price rule applies to. CUSTOMER is the most specific; TIER covers a customer grade.
/// The item list price (Item.listPricePaise) is the implicit third, least-specific tier.
enum PriceScope {
  CUSTOMER
  TIER
}

/// A quotation: the pre-order document that captures an agreed price before a sales order
/// exists (spec S25). It reads S21 cost for a margin badge but touches no stock, credit, or
/// receivables — those begin only at the SO it converts into.
model Quotation {
  id                   String          @id @default(cuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id])
  docNo                String // QT/FY/seq
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id])
  shipToId             String?
  shipTo               ShipToAddress?  @relation(fields: [shipToId], references: [id])
  enquiryDate          DateTime        @default(now())
  validUntil           DateTime
  status               QuotationStatus @default(DRAFT)
  /// Resolved whole-order value discount % at quote time (spec S25 rule 3), applied to the
  /// taxable subtotal before GST. Snapshotted so a later tier change never rewrites the quote.
  orderDiscountPct     Decimal         @default(0) @db.Decimal(5, 2)
  lostReason           String?
  /// Set once when the quote is converted to a sales order — re-conversion is refused.
  convertedSoId        String?         @unique
  convertedSo          SalesOrder?     @relation("QuotationConversion", fields: [convertedSoId], references: [id])
  marginOverrideById   String? // ADMIN/ACCOUNTS who cleared a below-floor margin warning
  marginOverrideReason String?
  createdById          String?
  createdAt            DateTime        @default(now())

  lines QuotationLine[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, status])
  @@index([customerId])
}

/// One quoted line. `ratePaise` is the agreed price per billed unit; `unitCostPaise` is a
/// snapshot of the item's cost at quote time (S21) so the margin shown is stable.
model QuotationLine {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id])
  qtyQuoted     Decimal   @db.Decimal(14, 4)
  uom           String
  ratePaise     BigInt
  gstRatePct    Decimal   @db.Decimal(5, 2)
  unitCostPaise BigInt    @default(0)

  @@index([quotationId])
  @@index([itemId])
}

/// A customer- or tier-scoped agreed price list, valid over a window (spec S25). Resolution
/// precedence is CUSTOMER > TIER > item list price; within a contract the highest qty slab the
/// order clears wins. Cancel-not-supersede: a rate change is a new contract.
model PriceContract {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  docNo       String // PC/FY/seq
  scope       PriceScope
  customerId  String? // set when scope = CUSTOMER
  customer    Customer?           @relation(fields: [customerId], references: [id])
  tier        CustomerTier? // set when scope = TIER
  validFrom   DateTime            @default(now())
  validUntil  DateTime?
  status      PriceContractStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime            @default(now())

  lines PriceContractLine[]

  @@unique([companyId, docNo])
  @@index([companyId])
  @@index([companyId, scope, status])
  @@index([customerId])
}

/// One agreed rate for an item, from `minQty` upward (a quantity slab). The resolver picks the
/// highest `minQty` band the order quantity clears.
model PriceContractLine {
  id              String        @id @default(cuid())
  priceContractId String
  priceContract   PriceContract @relation(fields: [priceContractId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  minQty          Decimal       @default(0) @db.Decimal(14, 4)
  ratePaise       BigInt
  gstRatePct      Decimal       @db.Decimal(5, 2)

  @@index([priceContractId])
  @@index([itemId])
}

/// A whole-order value discount tier (spec S25 rule 3) — the second, orthogonal pricing axis.
/// Above `minOrderValuePaise` (pre-tax subtotal), `discountPct` comes off the taxable subtotal
/// before GST. Same specificity order as contracts: CUSTOMER before TIER.
model ValueDiscountTier {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  scope              PriceScope
  customerId         String? // set when scope = CUSTOMER
  customer           Customer?           @relation(fields: [customerId], references: [id])
  tier               CustomerTier? // set when scope = TIER
  minOrderValuePaise BigInt
  discountPct        Decimal             @db.Decimal(5, 2)
  validFrom          DateTime            @default(now())
  validUntil         DateTime?
  status             PriceContractStatus @default(ACTIVE)
  createdById        String?
  createdAt          DateTime            @default(now())

  @@index([companyId])
  @@index([companyId, scope, status])
  @@index([customerId])
}

// --- Mobile order-taking (spec S27) --------------------------------------------------

/// How a sales order was entered. MOBILE marks an order captured on the field-sales PWA.
enum SalesOrderSource {
  DESK
  MOBILE
}

/// Lifecycle of a mobile order submission. RECEIVED when uploaded; APPLIED once it has created
/// a sales order; REJECTED when it could not be applied (kept, never dropped); SUPERSEDED if
/// replaced. Idempotency is by `clientRequestId`.
enum MobileSubmissionStatus {
  RECEIVED
  APPLIED
  REJECTED
  SUPERSEDED
}

/// The server-side record of one field-sales PWA order submission (spec S27). The device is a
/// proposal; the server re-prices via S25 `resolvePrice` and runs the S18 credit check at apply,
/// so a submission's `payloadJson` (what the device thought) may differ from the created SO
/// (`priceDeltaJson` records where). `clientRequestId` is the dedupe key — re-submitting it never
/// creates a second order. Device queue state lives in IndexedDB, not here.
model OrderDraftSubmission {
  id              String                 @id @default(cuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id])
  clientRequestId String // device-generated idempotency key, unique per company
  submittedById   String? // the SALES rep (scalar, mirrors createdById elsewhere)
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id])
  shipToId        String
  payloadJson     Json // { lines: [{ itemId, qtyOrdered, uom, devicePricePaise }], pricedAsOf }
  status          MobileSubmissionStatus @default(RECEIVED)
  resultSoId      String?                @unique
  resultSo        SalesOrder?            @relation("MobileSubmissionSO", fields: [resultSoId], references: [id])
  priceDeltaJson  Json? // [{ itemId, devicePricePaise, serverPricePaise }] where they differed
  rejectionReason String?
  capturedAt      DateTime? // when the rep captured it on the device (may predate `at`)
  at              DateTime               @default(now())

  @@unique([companyId, clientRequestId])
  @@index([companyId])
  @@index([companyId, status])
}

/// A materialised snapshot of one reorder-scan result for one item (spec S28). The row preserves
/// every input the suggestion was computed from — on-hand, reorder point, avg daily consumption,
/// suggested qty — so the number a buyer acted on stays fixed even as consumption keeps moving
/// (the same snapshot discipline as quote cost S25 and moving-average valuation S20). A scan
/// EXPIREs any prior OPEN row for the item before writing a fresh one; a buyer's DRAFT PO links
/// via resultPoId and flips the row to PO_DRAFTED. Suggestions are advisory — never an auto-buy.
model ReorderSuggestion {
  id                  String                  @id @default(cuid())
  companyId           String
  company             Company                 @relation(fields: [companyId], references: [id])
  itemId              String
  item                Item                    @relation(fields: [itemId], references: [id])
  asOf                DateTime                @default(now())
  /// Available on-hand at scan time — excludes QC-hold and reject locations (spec S28 rule 3).
  onHandQty           Decimal                 @db.Decimal(16, 3)
  reorderPoint        Decimal                 @db.Decimal(16, 3)
  avgDailyConsumption Decimal                 @db.Decimal(16, 4)
  suggestedQty        Decimal                 @db.Decimal(16, 3)
  preferredSupplierId String?
  preferredSupplier   Supplier?               @relation(fields: [preferredSupplierId], references: [id])
  status              ReorderSuggestionStatus @default(OPEN)
  resultPoId          String?
  resultPo            PurchaseOrder?          @relation(fields: [resultPoId], references: [id])
  dismissedReason     String?
  generatedBy         String?
  createdAt           DateTime                @default(now())

  @@index([companyId])
  @@index([companyId, status])
  @@index([itemId])
}
