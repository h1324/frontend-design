rules_version = '2';

// Diamond Furniture — Firestore security rules.
// Roles are enforced HERE, not just in the UI. A user's role comes from a custom
// auth claim (set server-side with the Admin SDK), with a users/{uid}.role fallback.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role from custom claim first; fall back to the users/{uid} doc.
    function role() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'viewer');
    }

    function isOwner()  { return signedIn() && role() == 'owner'; }
    function canEdit()  { return signedIn() && (role() == 'owner' || role() == 'manager'); }

    // Inventory SKUs: everyone signed in can read; owner/manager can write.
    match /skus/{id} {
      allow read:  if signedIn();
      allow write: if canEdit();
    }

    // App settings (thresholds, period, lines, machines): read all, write editors.
    match /settings/{doc} {
      allow read:  if signedIn();
      allow write: if canEdit();
    }

    // Production log: read all, editors append. No edits/deletes to history.
    match /productionLog/{id} {
      allow read:   if signedIn();
      allow create: if canEdit();
      allow update, delete: if false;
    }

    // Audit trail: append-only; OWNER-ONLY read (the "who changed what" log).
    match /audit/{id} {
      allow read:   if isOwner();
      allow create: if canEdit();
      allow update, delete: if false;
    }

    // User directory + role mapping.
    //  - read: your own profile, or any profile if you're an owner (owners list the team).
    //  - create: you may create only your OWN profile, and only as a viewer
    //    (this is how in-app sign-up registers a new user — no self-promotion).
    //  - update: only owners change roles, and an owner cannot demote themselves
    //    (prevents locking the last owner out).
    //  - delete: owners may remove others, never themselves.
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'viewer';
      allow update: if isOwner()
                    && !(uid == request.auth.uid && request.resource.data.role != 'owner');
      allow delete: if isOwner() && uid != request.auth.uid;
    }
  }
}
