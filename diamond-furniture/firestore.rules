rules_version = '2';

// Diamond Furniture — Firestore security rules.
// Roles are enforced HERE, not just in the UI. A user's role comes from the
// users/{uid} doc (owner-managed), with an optional custom-claim override.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role resolution.
    // IMPORTANT: read possibly-absent fields with .get(key, default). A bare
    // `request.auth.token.role` THROWS ("Property role is undefined") when the
    // custom claim isn't set — which is the normal case here (roles live in the
    // users doc, not on the token) — and that error denies EVERY write for
    // everyone, owners included. .get() returns the default instead of throwing.
    // Precedence: custom claim (if present) → users/{uid}.role → 'viewer'.
    function role() {
      return request.auth.token.get('role', '') != ''
        ? request.auth.token.get('role', 'viewer')
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'viewer')
            : 'viewer');
    }

    function isOwner()  { return signedIn() && role() == 'owner'; }
    function canEdit()  { return signedIn() && (role() == 'owner' || role() == 'manager'); }

    // Permanent SKU catalogue: everyone signed in can read; owner/manager write.
    match /catalog/{id} {
      allow read:  if signedIn();
      allow write: if canEdit();
    }

    // Monthly snapshots (one doc per month): read all, editors write/delete.
    match /periods/{key} {
      allow read:  if signedIn();
      allow write: if canEdit();
    }

    // Orders: read all signed in; owner/manager create/update (fulfil, cancel).
    // Deletes happen only in the owner-run year-end scrub.
    match /orders/{id} {
      allow read:   if signedIn();
      allow create, update: if canEdit();
      allow delete: if isOwner();
    }

    // Legacy per-SKU collection, kept as a migration backup. Read-only now.
    match /skus/{id} {
      allow read:  if signedIn();
      allow write: if canEdit();
    }

    // App settings (thresholds, period, lines, machines): read all, write editors.
    match /settings/{doc} {
      allow read:  if signedIn();
      allow write: if canEdit();
    }

    // Production log: read all, editors append. No edits/deletes to history.
    match /productionLog/{id} {
      allow read:   if signedIn();
      allow create: if canEdit();
      allow update, delete: if false;
    }

    // Audit trail: append-only; OWNER-ONLY read (the "who changed what" log).
    match /audit/{id} {
      allow read:   if isOwner();
      allow create: if canEdit();
      allow update, delete: if false;
    }

    // User directory + role mapping.
    //  - read: your own profile, or any profile if you're an owner.
    //  - create: you may create only your OWN profile, and only as a viewer.
    //  - update: only owners change roles; an owner cannot demote themselves.
    //  - delete: owners may remove others, never themselves.
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.get('role', '') == 'viewer';
      allow update: if isOwner()
                    && !(uid == request.auth.uid && request.resource.data.get('role', '') != 'owner');
      allow delete: if isOwner() && uid != request.auth.uid;
    }
  }
}
