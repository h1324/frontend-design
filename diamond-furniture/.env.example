# Firebase web config. Copy to `.env` and fill from your Firebase project
# (Project settings → General → Your apps → SDK setup & configuration).
#
# Leave these BLANK to run the app in local demo mode (bundled data +
# localStorage, no sign-in). Fill them in to switch to real cloud multi-user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
